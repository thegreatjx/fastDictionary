/build/
/.mygo/
mygo_windows_*.syso

# 可执行文件（每个 20MB，留三个备份就是 60MB 噪音）
*.exe
*.exe~
*.exe.bak-*

# 运行时日志
*.log

# 开发时临时截的图。正式的界面截图放 docs/screenshots/，不进这里。
diag_*.png
test_*.png
shot_*.png

# 缓存
cache/

# OCR 运行时依赖：模型 31MB、DLL 16MB。
#
# 不进仓库是因为体积，但打包时必须和 exe 放在一起，否则截图识别会静默
# 回落到 Windows OCR（质量差很多，而且不报错）。build.ps1 负责复制。
/indra-models/
/onnxruntime.dll
